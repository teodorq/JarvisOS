# Desktop client (set only after the HTTPS endpoint is deployed)
JARVIS_OS_CLOUD_URL=https://replace-with-container-app.example
JARVIS_OS_CLOUD_API_TOKEN=replace-with-a-random-secret
JARVIS_OS_CLOUD_TIMEOUT_SECONDS=30
JARVIS_OS_CLOUD_FAILURE_COOLDOWN_SECONDS=60
JARVIS_OS_REMOTE_DEVICE_ID=desktop-main
# Queue-scoped SAS URL; grant only process permission and keep it private.
JARVIS_OS_REMOTE_QUEUE_URL=https://replace.queue.core.windows.net/commands?sv=...
JARVIS_OS_REMOTE_POLL_SECONDS=5
