# Desktop client (set only after the HTTPS endpoint is deployed)
JARVIS_OS_CLOUD_URL=https://replace-with-container-app.example
JARVIS_OS_CLOUD_API_TOKEN=replace-with-a-random-secret
JARVIS_OS_CLOUD_TIMEOUT_SECONDS=30
JARVIS_OS_CLOUD_FAILURE_COOLDOWN_SECONDS=60
JARVIS_OS_REMOTE_DEVICE_ID=desktop-main
# Queue URL without SAS. The signed-in Microsoft Entra user needs only the
# Storage Queue Data Message Processor role on this queue.
JARVIS_OS_REMOTE_QUEUE_URL=https://replace.queue.core.windows.net/commands
JARVIS_OS_REMOTE_POLL_SECONDS=5

# Optional external services. They remain inactive until ENABLED=true and the
# corresponding local secret is provided. Meta Ads and RevenueCat are strictly
# read-only in JARVIS OS; there is no switch that exposes mutation tools.
JARVIS_OS_REVENUECAT_MCP_ENABLED=false
JARVIS_OS_REVENUECAT_MCP_URL=https://mcp.revenuecat.ai/mcp
# JARVIS_OS_REVENUECAT_MCP_TOKEN=dedicated-read-only-api-v2-key

# No Meta Ads URL is assumed to be official. Enter the reviewed HTTPS endpoint
# and repeat its exact DNS hostname in the allowlist before enabling it.
JARVIS_OS_META_ADS_MCP_ENABLED=false
# JARVIS_OS_META_ADS_MCP_URL=https://reviewed-connector.example/mcp
# JARVIS_OS_META_ADS_MCP_ALLOWED_HOSTS=reviewed-connector.example
# JARVIS_OS_META_ADS_MCP_ACCESS_TOKEN=read-only-token

# Claude is an optional reasoning-only provider. It receives no tools and each
# outbound request additionally needs an explicit remote-content approval.
JARVIS_OS_CLAUDE_ENABLED=false
JARVIS_OS_CLAUDE_API_URL=https://api.anthropic.com/v1/messages
# JARVIS_OS_CLAUDE_MODEL=verified-pinned-model-id
# ANTHROPIC_API_KEY=local-secret
