# Optional cloud text-to-speech. Copy this file to config/voice.env.
# Keep the copied file local; it is ignored by Git.
# Leave the provider empty to keep the existing local JARVIS OS voice.
JARVIS_OS_VOICE_PROVIDER=
JARVIS_OS_VOICE_TIMEOUT_SECONDS=25

# Cartesia (provider value: CARTESIA)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
JARVIS_OS_CARTESIA_MODEL_ID=sonic-3

# ElevenLabs (provider value: ELEVENLABS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
JARVIS_OS_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
