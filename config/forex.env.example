# Read-only Forex data. Copy this template to config/forex.env.
# No real-money or order endpoint is supported by these settings.
JARVIS_OS_FOREX_DATA_ENABLED=false

# OANDA fxTrade Practice only (never the live fxTrade host).
# JARVIS_OS_OANDA_PRACTICE_ACCOUNT_ID=practice-account-id
# JARVIS_OS_OANDA_PRACTICE_TOKEN=practice-personal-access-token

# Independent real-time midpoint cross-check.
# JARVIS_OS_TWELVE_DATA_API_KEY=local-api-key

# Economic calendar; only the stable read-only calendar route is used.
# JARVIS_OS_FMP_API_KEY=local-api-key
